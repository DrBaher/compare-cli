{
  "name": "compare-cli",
  "version": "0.4.1",
  "description": "Clause-aware drift detection between two contract versions. Pre-signature gate for legal teams and agent pipelines. Part of the contract-ops suite.",
  "type": "module",
  "bin": {
    "compare": "./compare-cli.mjs"
  },
  "main": "./compare-cli.mjs",
  "exports": {
    ".": "./compare-cli.mjs"
  },
  "files": [
    "compare-cli.mjs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "AGENTS.md",
    "ARCHITECTURE.md",
    "COMPARE_SCHEMA.md",
    "FAQ.md",
    "GETTING_STARTED.md",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test tests/test_*.mjs",
    "test:quick": "node --test tests/test_classify.mjs tests/test_clauses.mjs tests/test_args.mjs",
    "coverage": "node --test --experimental-test-coverage tests/test_*.mjs",
    "smoke": "npm pack && npm install -g $(ls -1t *.tgz | head -n1) && compare --version && compare --demo --json | head -n 5"
  },
  "keywords": [
    "legal",
    "legal-tech",
    "contracts",
    "contract-ops",
    "diff",
    "compare",
    "drift",
    "pre-signature",
    "cli",
    "agent-first"
  ],
  "author": "DrBaher",
  "license": "MIT",
  "homepage": "https://cli.drbaher.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/DrBaher/compare-cli.git"
  },
  "bugs": {
    "url": "https://github.com/DrBaher/compare-cli/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "pdfjs-dist": "^5.7.284"
  },
  "workspaces": [
    "mcp"
  ]
}
