    "outputSchema": {
      "type": "object",
      "description": "compare-cli --json report shape (stable across v1.x). See AGENTS.md and COMPARE_SCHEMA.md §10.",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "exit_class": {
          "type": "string",
          "enum": [
            "clean",
            "cosmetic",
            "typographic",
            "substantive",
            "moved"
          ]
        },
        "exit_code": {
          "type": "integer"
        },
        "base": {
          "type": "object"
        },
        "candidate": {
          "type": "object"
        },
        "summary": {
          "type": "object"
        },
        "differences": {
          "type": "array"
        },
        "warnings": {
          "type": "array"
        }
      },
      "required": [
        "ok",
        "exit_class",
        "exit_code",
        "base",
        "candidate",
        "summary",
        "differences",
        "warnings"
      ]
    }
  }
]